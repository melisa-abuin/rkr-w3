# Admin app environment variables
# Copy to .env.local and fill with real values.

# PostgreSQL connection string used by admin APIs and instrumentation.
DATABASE_URL=postgresql://user:password@host:5432/database

# Discord OAuth app credentials for admin login.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Discord authorization settings.
DISCORD_GUILD_ID=
# Comma-separated role IDs allowed to access admin.
DISCORD_ADMIN_ROLE_IDS=
